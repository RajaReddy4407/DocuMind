PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Supabase -> Project Settings -> API (use the service_role key; keep it server-side only!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# STAGE 1: FREE CLOUD OCR (reads images & PDFs into raw text)
# ============================================================================
# Options: 'auto' | 'ocrspace' | 'azure' | 'google_vision' | 'mindee'
OCR_PROVIDER=auto

# Option A (Default): OCR.space Free Cloud OCR (25,000 req/month free at https://ocr.space/ocrapi/freekey)
# Works out of the box with 'helloworld' public key or your free key
OCR_SPACE_API_KEY=helloworld

# Option B: Azure AI Document Intelligence Free Tier (500 pages/month free)
# AZURE_DOC_INTEL_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_DOC_INTEL_KEY=your-azure-key

# Option C: Google Cloud Vision API Free Tier (1,000 pages/month free)
# GOOGLE_VISION_API_KEY=your-google-vision-key

# Option D: Mindee Financial Document API Free Tier (250 pages/month free)
# MINDEE_API_KEY=your-mindee-key

# ============================================================================
# STAGE 2: LLM REASONING (reasons over the OCR text to extract, audit & chat)
# ============================================================================
# Option A: Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Option B: Groq Free Cloud LLM (https://console.groq.com/keys)
# GROQ_API_KEY=your-free-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile
